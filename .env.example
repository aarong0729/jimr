# Copy this to .env and fill in your actual values

# API Keys (required)
OPENAI_API_KEY=sk-your-openai-key-here

# Voice synthesis (optional - leave blank to disable voice)
ELEVENLABS_API_KEY=your-elevenlabs-key-here
JIM_ROHN_VOICE_ID=your-voice-id-here

# Security (required for production)
# Generate SECRET_KEY with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-session-key-here
ADMIN_PASSWORD=your-secure-admin-password

# Server config
PORT=5001

# Database (Railway provides this automatically)
# If not set, falls back to JSON file storage
DATABASE_URL=postgresql://user:password@host:5432/database
